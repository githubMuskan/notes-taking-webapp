<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/stylesheets/style1.css">
</head>
<body class="bg-dark text-white">
    <h1>Welcome to my website</h1>
    <div class="container">
        <form action="/create" method="post">
            <div class="row d-flex flex-column">
                <div class="col m-2 ">
                    <input class="form-control" type="text" placeholder="enter your subject" name="title">
                </div>
                <div class="col m-2">
                    <textarea class="form-control" placeholder="write your text detail here" rows="6" cols="30" name="details"></textarea>
                </div>
                <div class="col m-2">
                    <input type="submit" value="create task" class="btn btn-primary">
                </div>
            </div>
        </form>
        <div class="row row-cols-3 d-flex justify-content-between">
            <% if(files.length>0){ %>
                <% files.forEach((val)=>{ %>
                    <div class="col border border-1 border-light rounded-2 m-3 w-25 p-3 bg-gradient">
                        <h6><%= val %></h6>
                        <div class="d-flex justify-content-between">
                            <a class="text-primary" href="/files/<%= val %>" >read more</a>
                            <a class="text-info" >edit</a>
                        </div>

                    </div>
                <% })%>
            <% }else{ %>
                <p>No files found.</p>
            <% } %>
    
        </div>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>
</body>
</html>